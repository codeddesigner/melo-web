{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.melo.to"
        }
      ],
      "destination": "https://melo.to/:path*",
      "permanent": false
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/signin.html",
      "destination": "/signin",
      "permanent": true
    },
    {
      "source": "/signup.html",
      "destination": "/signup",
      "permanent": true
    },
    {
      "source": "/app.html",
      "destination": "/app",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|fonts/|favicon\\.svg|logo\\.svg|wordmark\\.svg|[a-z]+\\.css).*)",
      "has": [
        {
          "type": "host",
          "value": "melo.to"
        }
      ],
      "destination": "/personal"
    },
    {
      "source": "/((?!assets/|fonts/|favicon\\.svg|logo\\.svg|wordmark\\.svg|[a-z]+\\.css).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
